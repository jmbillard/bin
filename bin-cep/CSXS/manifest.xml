<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.jmbillard.bin" ExtensionBundleVersion="3.0.0" ExtensionBundleName="BIN v3 beta 1"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<ExtensionList>
		<Extension Id="com.jmbillard.bin.panel" Version="3.0.0" />
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<!-- After Effects 2020 (17.0) ou superior -->
			<Host Name="AEFT" Version="[17.0,99.9]" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="9.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<Extension Id="com.jmbillard.bin.panel">
			<DispatchInfo>
				<Resources>
					<MainPath>./index.html</MainPath>
					<ScriptPath>./jsx/host.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>BIN</Menu>
					<Geometry>
						<Size>
							<Height>720</Height>
							<Width>420</Width>
						</Size>
						<MinSize>
							<Height>400</Height>
							<Width>320</Width>
						</MinSize>
						<MaxSize>
							<Height>3000</Height>
							<Width>3000</Width>
						</MaxSize>
					</Geometry>
					<Icons>
						<Icon Type="Normal">./icons/icon_normal.png</Icon>
						<Icon Type="RollOver">./icons/icon_rollover.png</Icon>
						<Icon Type="DarkNormal">./icons/icon_dark_normal.png</Icon>
						<Icon Type="DarkRollOver">./icons/icon_dark_rollover.png</Icon>
					</Icons>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
